# ====== Banco de dados (PostgreSQL 15+) ======
# Local: postgres://toyville:toyville@localhost:5432/toyville
# Supabase: use a "connection string" do pooler (Settings > Database). Em serverless, prefira a porta 6543 (transaction pooler).
DATABASE_URL=postgres://toyville:toyville@localhost:5432/toyville

# URL pública do site (sem barra no fim). Usada em links de e-mail, back_urls e webhook do Mercado Pago.
APP_URL=http://localhost:3000

# Segredo para tarefas agendadas (expiração de pedidos). Gere com: openssl rand -hex 32
CRON_SECRET=

# Código para a tela /admin/primeiro-acesso (criar o proprietário sem terminal). 16+ caracteres.
# A tela só funciona enquanto não houver proprietário. Pode apagar a variável depois.
SETUP_TOKEN=

# Opcional: conexão para migrações (Supabase: string do "Session pooler"). Sem ela, usa DATABASE_URL.
DATABASE_URL_DIRECT=

# ====== Mercado Pago (Checkout Pro) ======
# Credenciais de TESTE ou PRODUÇÃO em https://www.mercadopago.com.br/developers/panel/app
# NUNCA coloque estes valores no código nem em variáveis NEXT_PUBLIC_.
MP_ACCESS_TOKEN=
# Ambiente das credenciais acima: test | production (no Checkout Pro as de teste também começam com APP_USR-)
MP_ENVIRONMENT=test
# Chave secreta dos webhooks (Suas integrações > Webhooks > Configurar notificações > revelar chave)
MP_WEBHOOK_SECRET=
# Nome que aparece na fatura do cartão (até 13 caracteres)
MP_STATEMENT_DESCRIPTOR=TOYVILLE
# Somente para testes automatizados: aponta a API para um servidor simulado. Deixe vazio.
MP_API_BASE_URL=

# ====== Armazenamento de imagens ======
# local = grava em public/uploads (apenas desenvolvimento / servidor com disco persistente)
# supabase = Supabase Storage (bucket público)
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=produtos
# Host das imagens (para next/image), ex.: abcd.supabase.co
STORAGE_PUBLIC_HOST=

# ====== E-mail transacional ======
# Sem provedor configurado, os e-mails ficam na "caixa de saída" do painel (não são enviados).
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM="ToyVille <nao-responda@seudominio.com.br>"
